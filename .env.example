# Copy this file to .env for local runs. .env is git-ignored: never commit real keys.
# In GitHub Actions, set the same names under Settings > Secrets and variables > Actions.

ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_TRANSLATE_API_KEY=...
DEEPL_API_KEY=...          # DeepL API Free keys end in ":fx"

# Optional: override the Claude model used for gate, translation and judge
# ANTHROPIC_MODEL=claude-sonnet-5-5
